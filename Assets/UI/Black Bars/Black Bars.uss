:root {
}

.bar {
    background-color: rgb(0, 0, 0);
    position: absolute;
    height: 0;
    transition-property: height, visibility;
    transition-duration: 1s, 0s;
    transition-timing-function: ease-out-circ, ease;
    transition-delay: 0s, 1s;
    visibility: hidden;
}

.bar__top {
    top: 0;
    left: 0;
    right: 0;
}

.bar__bottom {
    left: 0;
    right: 0;
    bottom: 0;
}

.bar--active {
    height: 150px;
    visibility: visible;
    transition-property: height;
    transition-duration: 1s;
    transition-timing-function: ease-out-cubic;
}

.bars_container {
    width: 100%;
    height: 100%;
}
