:root {
}

.bar {
    background-color: rgb(0, 0, 0);
    position: absolute;
    height: 0;
    transition-property: height;
    transition-duration: 2s;
    transition-timing-function: ease-out-circ;
    transition-delay: 0s;
}

.bar__top {
    top: 0;
    left: 0;
    right: 0;
}

.bar__bottom {
    left: 0;
    right: 0;
    bottom: 0;
}

.bar--active {
    height: 100px;
    transition-duration: 1s;
}

.bars_container {
    width: 100%;
    height: 100%;
}
