:root {
}

.dialog-container {
    position: absolute;
    left: 64px;
    right: 64px;
    bottom: 32px;
    height: 150px;
    display: none;
}

.dialog-container.visible {
    display: flex;
}

.dialog-box {
    background-color: rgba(10, 10, 41, 0.89);
    padding-top: 32px;
    padding-right: 32px;
    padding-bottom: 8px;
    padding-left: 32px;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
}

.speaker {
    font-size: 24px;
    font-weight: bold;
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Sora/Sora-ExtraBold.ttf?fileID=12800000&guid=ce573c940558d4741a0219b8ce511280&type=3#Sora-ExtraBold");
    -unity-font-style: normal;
    -unity-text-align: upper-left;
}

.speaker-box {
    position: absolute;
    top: -24px;
    left: -16px;
    padding-left: 8px;
    padding-right: 16px;
    min-width: 200px;
    background-color: rgb(255, 255, 255);
}

.dialog {
    font-size: 18px;
    font-weight: bold;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Sora/Sora-ExtraBold.ttf?fileID=12800000&guid=ce573c940558d4741a0219b8ce511280&type=3#Sora-ExtraBold");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-grow: 1;
}

.options {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-top: 16px;
    margin-right: 16px;
    margin-bottom: 16px;
    margin-left: 16px;
}

.options .unity-button {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/Fonts/Sora/Sora-ExtraBold.ttf?fileID=12800000&guid=ce573c940558d4741a0219b8ce511280&type=3#Sora-ExtraBold");
    font-size: 20px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 8px;
    padding-right: 16px;
    padding-bottom: 8px;
    padding-left: 16px;
    min-width: 150px;
}

.next-indicator {
    translate: 0 -50%;
    opacity: 0;
}

.next-indicator.visible {
    translate: 0 0;
    opacity: 1;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
    transition-delay: 0s;
}
