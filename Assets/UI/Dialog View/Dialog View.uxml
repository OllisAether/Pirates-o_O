<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Dialog%20View/Dialog%20View.uss?fileID=7433441132597879392&amp;guid=2a082398aff544c8e8e9033e424cf993&amp;type=3#Dialog View"/>
    <DialogView class="dialog-container visible" style="transition-duration: 0.3s, 0.5s;">
        <ui:VisualElement class="dialog-box">
            <ui:Label text="Lorem ipsum dolor sit amet, consetetur sadipscing elitr." name="dialog" class="dialog" style="font-size: 20px;"/>
            <ui:VisualElement name="next-indicator" class="next-indicator visible">
                <ui:VisualElement style="flex-grow: 1; border-top-width: 15px; border-left-width: 5px; border-right-width: 5px; border-right-color: rgba(0, 0, 0, 0); border-top-color: rgb(255, 255, 255); border-bottom-width: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="options" class="options">
            <ui:Button text="Button"/>
        </ui:VisualElement>
        <ui:VisualElement class="speaker-box">
            <ui:Label text="Speaker" name="speaker" class="speaker"/>
        </ui:VisualElement>
    </DialogView>
</ui:UXML>
