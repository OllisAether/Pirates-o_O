<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="current-objective-container" style="flex-grow: 1; margin-bottom: 16px;">
        <ui:VisualElement name="" style="flex-grow: 1; border-bottom-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
            <ui:Label text="Objective Title" name="current-objective-title" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Sora/Sora-Regular.ttf?fileID=12800000&amp;guid=160f842ac022242909345e06dc319da0&amp;type=3#Sora-Regular&quot;); font-size: 22px;"/>
            <ui:Label text="Objective Description" name="current-objective-desc" style="margin-top: 0; padding-top: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 0; background-color: rgb(255, 255, 255); width: 8px; height: 8px; flex-shrink: 0; align-self: center; margin-right: 6px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; margin-left: 4px;"/>
            <ui:Label text="Objective Step" name="current-objective-step"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
